---
import Head from "@components/Head.astro";
import Header from "@components/Header.astro";
import Footer from "@components/Footer.astro";
import Pagefind from "@components/PageFind.astro";
import GiscusLoader from "@components/GiscusLoader.astro";
import { SITE } from "@consts";
import {
  type Locale,
  DEFAULT_LOCALE,
  buildPageAlternates,
  getLocaleFromPath,
} from "@lib/i18n";

type Props = {
  title?: string;
  description: string;
  lang?: Locale;
  alternates?: { lang: Locale; href: string }[];
};

const { title, description, lang = DEFAULT_LOCALE, alternates } = Astro.props;
const pageTitle = title ? `${SITE.TITLE} | ${title}` : SITE.TITLE;
const resolvedAlternates =
  alternates ?? buildPageAlternates(Astro.url.pathname);
const currentLang = lang ?? getLocaleFromPath(Astro.url.pathname);
---

<!doctype html>
<html lang={currentLang}>
  <head>
    <Head
      title={pageTitle}
      description={description}
      lang={currentLang}
      alternates={resolvedAlternates}
    />
  </head>
  <body>
    <noscript>
      <style>
        .animate{
          opacity:1;
          translate: var(--tw-translate-x) calc(var(--spacing) * 0);
        }
      </style>
    </noscript>
    <Header lang={currentLang} alternates={resolvedAlternates} />
    <main>
      <slot />
    </main>
    <Footer lang={currentLang} />
    <Pagefind lang={currentLang} />
    <GiscusLoader />

    <script is:inline>
      function trackView() {
        const payload = { path: window.location.pathname };
        if (document.referrer) {
          payload.referrer = document.referrer;
        }

        fetch('/api/v1/views', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          credentials: 'same-origin',
          body: JSON.stringify(payload),
          keepalive: true,
        }).catch(() => {});
      }

      document.addEventListener('DOMContentLoaded', trackView);
      document.addEventListener('astro:after-swap', trackView);
    </script>
  </body>
</html>
