---
import { type Locale } from "@lib/i18n";

interface Props {
  date: Date;
  lang?: Locale;
}

const { date, lang = "ru" } = Astro.props;
---

<time datetime={date.toISOString()}>
  {
    date.toLocaleDateString(lang === "en" ? "en-US" : "ru-RU", {
      month: "long",
      day: "2-digit",
      year: "numeric",
    })
  }
</time>
