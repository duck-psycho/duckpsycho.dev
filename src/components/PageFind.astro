---
import Search from "astro-pagefind/components/Search";
import { type Locale } from "@lib/i18n";
import { t } from "@i18n/ui";

type Props = {
  lang: Locale;
};

const { lang } = Astro.props;
const ui = t(lang);
---

<aside data-pagefind-ignore>
  <div
    id="backdrop"
    class="bg-[rgba(0,0,0,0.5)] invisible fixed left-0 top-0 z-50 flex h-screen w-full justify-center p-6 backdrop-blur-xs"
  >
    <div
      id="pagefind-container"
      class="m-0 flex h-fit max-h-[80%] w-full max-w-(--breakpoint-sm) flex-col overflow-auto rounded-sm border border-black/15 bg-neutral-100 p-2 px-4 py-3 shadow-lg dark:border-white/20 dark:bg-neutral-900"
    >
      <Search
        id="search"
        className="pagefind-ui"
        uiOptions={{
          showImages: false,
          excerptLength: 15,
          resetStyles: false,
        }}
      />
      <div class="mr-2 pb-1 pt-4 text-right text-xs dark:prose-invert">
        {ui.search.closePrefix}{" "}
        <span class="prose text-xs dark:prose-invert"><kbd class="">Esc</kbd></span>
        {ui.search.closeSuffix}
      </div>
    </div>
  </div>
</aside>

<script is:inline>
  function openPagefind() {
    const backdrop = document.getElementById("backdrop");
    backdrop?.classList.remove("invisible");
    backdrop?.classList.add("visible");

    const input = document.getElementById("search")?.querySelector("input");
    if (input) {
      setTimeout(() => {
        input.focus();
      }, 0);
    }
  }

  function closePagefind() {
    const backdrop = document.getElementById("backdrop");
    const input = document.getElementById("search")?.querySelector("input");
    if (input) input.value = "";
    backdrop?.classList.remove("visible");
    backdrop?.classList.add("invisible");
  }

  function initPagefind() {
    const magnifyingGlass = document.getElementById("magnifying-glass");
    const backdrop = document.getElementById("backdrop");

    if (magnifyingGlass) {
      magnifyingGlass.onclick = openPagefind;
    }

    if (backdrop) {
      backdrop.onclick = (event) => {
        if (
          event.target instanceof Element &&
          !event.target.closest("#pagefind-container")
        ) {
          closePagefind();
        }
      };
    }
  }

  let shortcutsBound = false;

  function initPagefindShortcuts() {
    if (shortcutsBound) return;
    shortcutsBound = true;

    document.addEventListener("keydown", (e) => {
      if (e.key === "/") {
        e.preventDefault();
        openPagefind();
      } else if ((e.metaKey || e.ctrlKey) && e.key === "k") {
        e.preventDefault();
        openPagefind();
      } else if (e.key === "Escape") {
        closePagefind();
      }
    });

    document.addEventListener("click", (event) => {
      if (
        event.target instanceof Element &&
        event.target.classList.contains("pagefind-ui__result-link")
      ) {
        closePagefind();
      }
    });
  }

  function initPagefindControls() {
    initPagefind();
    initPagefindShortcuts();
  }

  document.addEventListener("DOMContentLoaded", initPagefindControls);
  document.addEventListener("astro:after-swap", initPagefindControls);
</script>

<style is:global>
  :root {
    --pagefind-ui-scale: 0.75;
    --pagefind-ui-border-width: 1px;
    --pagefind-ui-border-radius: 3px;
    --pagefind-ui-font: "Geist", sans-serif;
    --pagefind-ui-primary: #3d3d3d;
    --pagefind-ui-text: #3d3d3d;
    --pagefind-ui-background: #ffffff;
    --pagefind-ui-border: #d0d0d0;
    --pagefind-ui-tag: #f5f5f5;
  }

  .dark {
    --pagefind-ui-primary: #d4d4d4;
    --pagefind-ui-text: #d4d4d4;
    --pagefind-ui-background: #171717;
    --pagefind-ui-border: #404040;
  }

  #search input {
    font-weight: normal;
  }

  #search .pagefind-ui__search-input {
    outline: none;
  }

  #search .pagefind-ui__search-input:focus,
  #search .pagefind-ui__search-input:focus-visible {
    outline: none;
  }

  #search p {
    font-weight: normal;
  }

  #search .pagefind-ui__result-title {
    font-weight: 600;
  }

  #search .pagefind-ui__message {
    padding: 0;
    padding-bottom: 0.75rem;
  }
</style>
