---
import Container from "@components/Container.astro";
import Link from "@components/Link.astro";
import LanguageSwitcher from "@components/LanguageSwitcher.astro";
import { SITE } from "@consts";
import { type Locale } from "@lib/i18n";
import { localizePath } from "@lib/i18n";
import { blogIndexUrl, projectsIndexUrl } from "@lib/utils";
import { t } from "@i18n/ui";

type Props = {
  lang: Locale;
  alternates: { lang: Locale; href: string }[];
};

const { lang, alternates } = Astro.props;
const ui = t(lang);
---

<header>
  <Container>
    <div class="flex flex-wrap justify-between gap-y-2">
      <Link href={localizePath("/", lang)} underline={false}>
        <div class="font-semibold">
          {SITE.TITLE}
        </div>
      </Link>
      <nav class="flex items-center gap-1 text-sm">
        <button
          id="magnifying-glass"
          type="button"
          aria-label={ui.nav.search}
          class="flex size-8 items-center justify-center rounded-sm border-black/15 hover:bg-black/5 focus-visible:bg-black/5 dark:border-white/20 dark:hover:bg-white/5 dark:focus-visible:bg-white/5"
        >
          <svg
            xmlns="http://www.w3.org/2000/svg"
            width="16"
            height="16"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="1.5"
            stroke-linecap="round"
            stroke-linejoin="round"
          >
            <circle cx="11" cy="11" r="8"></circle>
            <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
          </svg>
        </button>
        <span>{`/`}</span>
        <Link href={blogIndexUrl(lang)}>{ui.nav.blog}</Link>
        <span>
          {`/`}
        </span>
        <Link href={projectsIndexUrl(lang)}>{ui.nav.projects}</Link>
        <span>{`/`}</span>
        <LanguageSwitcher lang={lang} alternates={alternates} />
      </nav>
    </div>
  </Container>
</header>
