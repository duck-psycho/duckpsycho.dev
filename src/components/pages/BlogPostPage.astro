---
import { type CollectionEntry, getCollection, render } from "astro:content";
import Layout from "@layouts/Layout.astro";
import Container from "@components/Container.astro";
import FormattedDate from "@components/FormattedDate.astro";
import { readingTime, tagUrl } from "@lib/utils";
import BackToPrevious from "@components/BackToPrevious.astro";
import PostNavigation from "@components/PostNavigation.astro";
import TableOfContents from "@components/TableOfContents.astro";
import Comments from "@components/Comments.astro";
import {
  buildContentAlternates,
  getSlugFromId,
  giscusTerm,
  type Locale,
} from "@lib/i18n";
import { getLocalizedBlog } from "@lib/content";
import { t } from "@i18n/ui";

type Props = {
  lang: Locale;
  post: CollectionEntry<"blog">;
};

const { lang, post } = Astro.props;
const ui = t(lang);

const posts = await getLocalizedBlog(lang);
const allPosts = await getCollection("blog");

const postIndex = posts.findIndex((item) => item.id === post.id);
const nextPost = postIndex >= 0 ? posts[postIndex + 1] : undefined;
const prevPost = postIndex >= 0 ? posts[postIndex - 1] : undefined;

const { Content, headings } = await render(post);
const slug = getSlugFromId(post.id);
const alternates = buildContentAlternates("blog", slug, allPosts);
---

<Layout
  lang={lang}
  title={post.data.title}
  description={post.data.description}
  alternates={alternates}
>
  <Container>
    <div class="animate">
      <BackToPrevious>{ui.common.back}</BackToPrevious>
    </div>
    <div class="my-10 space-y-1">
      <div class="animate flex items-center gap-1.5">
        <div class="font-base text-sm">
          <FormattedDate date={post.data.date} lang={lang} />
        </div>
        &bull;
        {post.body && (
          <div class="font-base text-sm">
            {readingTime(post.body, lang)}
          </div>
        )}
      </div>
      <h1 class="animate text-3xl font-semibold text-black dark:text-white">
        {post.data.title}
      </h1>
      {
        post.data.tags && post.data.tags?.length > 0 ? (
          <div class="animate flex gap-2 pt-1">
            {post.data.tags.map((tag) => (
              <a
                href={tagUrl(tag, lang)}
                class="rounded-sm border border-black/15 px-2 py-1 text-sm transition-colors duration-300 ease-in-out hover:bg-black/5 hover:text-black focus-visible:bg-black/5 focus-visible:text-black dark:border-white/20 dark:hover:bg-white/5 dark:hover:text-white dark:focus-visible:bg-white/5 dark:focus-visible:text-white"
              >
                {tag}
              </a>
            ))}
          </div>
        ) : null
      }
    </div>
    {headings.length > 0 && <TableOfContents headings={headings} lang={lang} />}
    <article class="animate">
      <Content />
      <Comments term={giscusTerm("blog", post.id)} lang={lang} />
      <div class="mt-24">
        <PostNavigation prevPost={prevPost} nextPost={nextPost} />
      </div>
    </article>
  </Container>
</Layout>
