---
import { GISCUS } from "@consts";
import { type Locale } from "@lib/i18n";
import { t } from "@i18n/ui";

type Props = {
  term: string;
  lang: Locale;
};

const { term, lang } = Astro.props;
const isConfigured = Boolean(GISCUS.REPO_ID && GISCUS.CATEGORY_ID);
const giscusLang = lang === "en" ? "en" : "ru";
const ui = t(lang);
---

{
  isConfigured && (
    <section class="mt-16 border-t border-black/10 pt-10 dark:border-white/10">
      <h2 class="mb-6 text-xl font-semibold text-black dark:text-white">
        {ui.common.comments}
      </h2>
      <div
        id="giscus-container"
        class="giscus"
        data-lang={giscusLang}
        data-term={term}
      />
    </section>
  )
}
