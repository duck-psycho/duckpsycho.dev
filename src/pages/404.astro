---
import Layout from "@layouts/Layout.astro";
import Container from "@components/Container.astro";
import BackToPrevious from "@components/BackToPrevious.astro";
import { t } from "@i18n/ui";
import { getLocaleFromPath } from "@lib/i18n";

const lang = getLocaleFromPath(Astro.url.pathname);
const ui = t(lang);
---

<Layout lang={lang} title="404" description={ui.site.description} alternates={[]}>
  <Container>
    <div class="mt-16 grid place-items-center gap-3">
      <h4 class="animate text-2xl font-semibold text-black dark:text-white">
        {ui.common.notFound}
      </h4>
      <span class="animate">
        <BackToPrevious>{ui.common.back}</BackToPrevious>
      </span>
    </div>
  </Container>
</Layout>
